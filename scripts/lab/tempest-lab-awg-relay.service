[Unit]
Description=TEMPEST isolated AWG test relay
Requires=tempest-lab-topology.service
After=tempest-lab-topology.service
Before=tempest-xray-agent.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 /opt/tempest/bin/working-core-awg-relay
Restart=on-failure
RestartSec=2s
TimeoutStartSec=10s
TimeoutStopSec=8s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
