[Unit]
Description=TEMPEST Network Agent (IPC mock; no network apply)
Documentation=file:/opt/tempest/docs/NETWORK_PLAN_IPC.md
After=local-fs.target

[Service]
Type=simple
User=tempest-agent
Group=tempest-control
WorkingDirectory=/opt/tempest/backend
Environment=PYTHONPATH=/opt/tempest/backend
EnvironmentFile=/etc/tempest/network-agent.env
ExecStart=/usr/bin/python3 -m app.network_agent --socket=/run/tempest-agent/control.sock --allowed-uids=${TEMPEST_AGENT_ALLOWED_UIDS} --allowed-gids=${TEMPEST_AGENT_ALLOWED_GIDS} --expected-cgroup=${TEMPEST_AGENT_EXPECTED_CGROUP}
Restart=on-failure
RestartSec=2s
UMask=0007

RuntimeDirectory=tempest-agent
RuntimeDirectoryMode=0750
ReadWritePaths=/run/tempest-agent

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
