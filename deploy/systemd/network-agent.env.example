# Copy to /etc/tempest/network-agent.env and set numeric IDs from the target host.
# Keep this file root-owned and unreadable by the Control Plane.
TEMPEST_AGENT_ALLOWED_UIDS=1001
TEMPEST_AGENT_ALLOWED_GIDS=1002

# Optional. Configure only after verifying peer PID/cgroup mapping on Linux.
# TEMPEST_AGENT_EXPECTED_CGROUP=/system.slice/tempest-control.service
