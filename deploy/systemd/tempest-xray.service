[Unit]
Description=TEMPEST Xray WireGuard gateway
BindsTo=tempest-xray-agent.service
After=tempest-xray-agent.service
AssertPathIsMountPoint=/run/netns/tempest-ns-xray

[Service]
Type=exec
User=tempest-xray
Group=tempest-xray
NetworkNamespacePath=/run/netns/tempest-ns-xray
ExecStart=/opt/tempest/bin/xray run -config /run/tempest-xray/active.json
Restart=no
TimeoutStopSec=3s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
