[Unit]
Description=TEMPEST AWG DNS adapter
BindsTo=tempest-xray-agent.service
After=tempest-xray-agent.service
AssertPathIsMountPoint=/run/netns/tempest-ns-xray

[Service]
Type=exec
User=tempest-awgproxy
Group=tempest-xray
NetworkNamespacePath=/run/netns/tempest-ns-xray
ExecStart=/opt/tempest/bin/sing-box run -c /run/tempest-xray/active-awg-dns.json
StandardOutput=null
StandardError=null
Restart=no
TimeoutStopSec=3s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
